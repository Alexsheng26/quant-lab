# 复制成 .env 后填入真实值。.env 已在 .gitignore 里，不会被提交。
#
# !! Key 绝不要贴进聊天记录、issue、截图或任何公开场合。
#    泄露过的 Key 立刻去控制台作废重建 —— GitHub 上的 Key
#    通常几分钟内就会被爬虫扫到并盗用。

# ---------------------------------------------------------------
# LLM —— 只用于语言任务（读新闻、读财报正文、串联结论）
#
# 打分、分位排名、回测绩效全部由确定性代码计算，不经过模型。
# 一个都不配也能用：相关功能降级成检索式 / 纯文本比对，不会报错。
# ---------------------------------------------------------------

# DeepSeek：国内直连，便宜一到两个数量级。读 10-K 正文首选。
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Claude：结构化输出更可靠。
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 两个都配时默认用 DeepSeek（便宜）。要强制指定就填 deepseek 或 claude。
# LLM_PROVIDER=deepseek

# 模型名可覆盖 —— 厂商命名会变，不用改代码。
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_MODEL=claude-opus-5

# 走代理或中转时覆盖基地址。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------
# 部署
# ---------------------------------------------------------------

# 每个 IP 每小时能调用多少次生成式接口。部署到公网后这是你的钱包保险丝。
LLM_CALLS_PER_HOUR=30

# 公网部署必须设置，否则任何人都能调你的后端（包括花钱的那些接口）。
# 逗号分隔，例如：https://yourname.github.io
# ALLOWED_ORIGINS=
